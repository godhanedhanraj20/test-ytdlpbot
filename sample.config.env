# Telegram API Credentials (from my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Bot Authentication (Choose ONE of the below)
# Option A: Standard Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Option B: Premium Pyrogram Session String (for 4GB file support)
# SESSION_STRING=your_pyrogram_session_string_here

# Access Control (Optional but RECOMMENDED)
# Specify your Telegram User ID here to become the Admin.
# Only the Admin (and users added via /adduser) can use the bot.
ADMIN_USER_ID=your_telegram_user_id

# Redis Configuration (Used by ARQ workers and caching)
REDIS_URL=redis://redis:6379/0
